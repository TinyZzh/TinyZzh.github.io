{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "useTabs": true,
  "tabWidth": 2,
  "printWidth": 80,
  "singleQuote": false,
  "jsxSingleQuote": false,
  "quoteProps": "as-needed",
  "trailingComma": "all",
  "semi": true,
  "arrowParens": "always",
  "bracketSameLine": false,
  "bracketSpacing": true,
  "endOfLine": "lf",
  "svelte": true,
  "ignorePatterns": [
    "**/src/**/*.css",
    "**/src/public/**/*",
    "**/dist/**/*",
    "**/node_modules/**/*",
    "**/src/constants/icons.ts"
  ]
}
